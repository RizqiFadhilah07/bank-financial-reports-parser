# Salin file ini menjadi .env lalu isi. JANGAN commit .env.
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_HOST=localhost
DB_NAME=
# DB_AUTH: windows (bawaan) atau sql
DB_AUTH=windows
# Hanya dipakai bila DB_AUTH=sql. Tulis password apa adanya, tanpa kurung kurawal.
DB_USER=
DB_PASSWORD=
# Isi yes hanya bila muncul error sertifikat SSL.
DB_TRUST_CERT=no
